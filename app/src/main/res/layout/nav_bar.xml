<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Белая подложка панели, высота по макету -->
    <View
        android:id="@+id/navBg"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/navbar_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/homeNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scaleType="center"
        android:src="@drawable/nav_home_selector"
        android:background="@null"
        android:contentDescription="@string/nav_home"
        app:layout_constraintTop_toTopOf="@id/navBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/activityNav" />

    <ImageButton
        android:id="@+id/activityNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scaleType="center"
        android:src="@drawable/activity_nav"
        android:background="@null"
        android:contentDescription="@string/nav_activity"
        app:layout_constraintTop_toTopOf="@id/navBg"
        app:layout_constraintStart_toEndOf="@id/homeNav"
        app:layout_constraintEnd_toStartOf="@id/searchSlot" />

    <Space
        android:id="@+id/searchSlot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/navBg"
        app:layout_constraintStart_toEndOf="@id/activityNav"
        app:layout_constraintEnd_toStartOf="@id/cameraNav" />

    <ImageButton
        android:id="@+id/cameraNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scaleType="center"
        android:src="@drawable/camera"
        android:background="@null"
        android:contentDescription="@string/nav_camera"
        app:layout_constraintTop_toTopOf="@id/navBg"
        app:layout_constraintStart_toEndOf="@id/searchSlot"
        app:layout_constraintEnd_toStartOf="@id/profileNav" />

    <ImageButton
        android:id="@+id/profileNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scaleType="center"
        android:src="@drawable/nav_profile_selector"
        android:background="@null"
        android:contentDescription="@string/nav_profile"
        app:layout_constraintTop_toTopOf="@id/navBg"
        app:layout_constraintStart_toEndOf="@id/cameraNav"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/searchNav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:src="@drawable/navbar_search"
        android:background="@null"
        android:contentDescription="@string/nav_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/searchSlot"
        app:layout_constraintEnd_toEndOf="@id/searchSlot" />

</androidx.constraintlayout.widget.ConstraintLayout>
