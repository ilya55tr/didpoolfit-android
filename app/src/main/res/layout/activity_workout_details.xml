<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:equipments="http://schemas.android.com/equipments"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    equipments:context=".WorkoutDetailsActivity">
    
    <TextView
        android:id="@+id/workout_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fullbody Workout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:fontFamily="@font/poppins_bold"
        android:textSize="16dp"
        android:textColor="@color/black"
        android:layout_margin="30dp"/>

    <TextView
        android:id="@+id/workout_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/workout_description"
        android:textColor="#AEAEB2"
        android:fontFamily="@font/poppins_regular"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/workout_name"
        android:layout_marginHorizontal="30dp"/>

    <TextView
        android:id="@+id/workout_equipments_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You’ll Need"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/workout_description"
        android:fontFamily="@font/poppins_bold"
        android:textSize="16dp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="30dp"
        android:layout_marginVertical="10dp"/>

    <TextView
        android:id="@+id/equipments_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/amount_items"
        android:textColor="#AEAEB2"
        android:fontFamily="@font/poppins_regular"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/workout_equipments_title"
        app:layout_constraintBottom_toBottomOf="@id/workout_equipments_title"
        android:layout_marginHorizontal="30dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/equipments_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/equipments_amount"
        android:layout_marginStart="30dp"
        android:layout_marginVertical="15dp"/>

    <TextView
        android:id="@+id/workout_exercise_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exercises"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/equipments_recycler_view"
        android:fontFamily="@font/poppins_bold"
        android:textSize="16dp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="30dp"
        android:layout_marginVertical="10dp"/>

    <TextView
        android:id="@+id/exercises_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/set_amount"
        android:textColor="#AEAEB2"
        android:fontFamily="@font/poppins_regular"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/workout_exercise_title"
        app:layout_constraintBottom_toBottomOf="@id/workout_exercise_title"
        android:layout_marginHorizontal="30dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/exercises_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/workout_exercise_title"
        android:layout_marginStart="30dp"
        android:layout_marginTop="15dp"/>


    <Button
        android:id="@+id/startWorkoutButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_button_gradient"
        android:text="@string/start_workout"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_bold"
        app:backgroundTint="@null"
        android:elevation="10dp"
        android:stateListAnimator="@null"
        android:outlineSpotShadowColor="@color/gradient_end_welcome_btn"
        android:outlineAmbientShadowColor="@color/gradient_end_welcome_btn"
        tools:targetApi="p"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
